<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Keep RN edit text styling -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- Elara system chrome -->
        <item name="android:statusBarColor">@color/elara_bg</item>
        <item name="android:navigationBarColor">@color/elara_bg</item>
        <item name="android:windowBackground">@color/elara_bg</item>

        <!-- Light icons/text on dark? set false; if you prefer dark icons, set true -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/elara_teal</item>
        <item name="colorPrimaryVariant">@color/elara_teal</item>
        <item name="colorOnPrimary">@color/elara_bg</item>

        <!-- Secondary for Material components -->
        <item name="colorSecondary">@color/elara_teal</item>
        <item name="colorOnSecondary">@color/elara_bg</item>
    </style>

    <!-- Widget text styles -->
    <style name="WidgetTextPrimary">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="WidgetTextSecondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
