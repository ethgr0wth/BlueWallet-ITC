<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Background (Cyan to Blue) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00B3B3"      <!-- Cyan color from the logo -->
                android:endColor="#006F6F"        <!-- Blue color from the logo -->
                android:angle="45" />             <!-- Gradient angle -->
        </shape>
    </item>

    <!-- Your Logo -->
    <item>
        <bitmap
            android:src="@mipmap/ic_launcher"   <!-- Replace with your logo resource -->
            android:gravity="center" />
    </item>
</layer-list>
